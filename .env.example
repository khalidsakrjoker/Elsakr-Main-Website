# Optional: injected at build time via vite.config.ts define (GEMINI integrations)
GEMINI_API_KEY=

# Alias of GEMINI_API_KEY — vite.config.ts also exposes this as process.env.API_KEY
API_KEY=

# Public WhatsApp business number (digits only, country code included, no +).
# Exposed to the client as import.meta.env.VITE_WHATSAPP_NUMBER (Vite VITE_ prefix).
VITE_WHATSAPP_NUMBER=

# Optional: override for the <lastmod> date in sitemap.xml and insights RSS (YYYY-MM-DD).
# Sourced at build time by scripts/generate-sitemap.mjs and scripts/prerender.mjs.
# Defaults to SITE_LASTMOD in lib/seo/routeManifest.ts when omitted.
SITEMAP_LASTMOD=

# Optional: external error-tracking ingestion endpoint (e.g. Sentry DSN or telemetry collector).
# Used by lib/logger.ts in production to forward structured error payloads.
VITE_ERROR_TRACKING_DSN=


