# Optional: injected at build time via vite.config.ts define (GEMINI integrations)
GEMINI_API_KEY=

# Alias of GEMINI_API_KEY — vite.config.ts also exposes this as process.env.API_KEY
API_KEY=

# Public WhatsApp business number (digits only, country code included, no +).
# Exposed to the client as import.meta.env.VITE_WHATSAPP_NUMBER (Vite VITE_ prefix).
VITE_WHATSAPP_NUMBER=
